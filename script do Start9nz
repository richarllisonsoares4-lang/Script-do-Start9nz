local SaveFolder = "ST_Recordings"
if not isfolder(SaveFolder) then
    makefolder(SaveFolder)
end

local Recording = false
local RecordedMoves = {}
local RecordingConnection = nil

local function RefreshRecordingsList(page)
    -- Limpa lista anterior
    for _, child in pairs(page:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local files = listfiles(SaveFolder)
    for _, filePath in ipairs(files) do
        local filename = filePath:match("([^\\]+)$")

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0.95, 0, 0, 90)
        frame.BackgroundColor3 = Color3.fromRGB(35, 35, 65)
        frame.Parent = page

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1,0,0.4,0)
        label.BackgroundTransparency = 1
        label.Text = "📼 " .. filename
        label.TextColor3 = Color3.new(1,1,1)
        label.TextScaled = true
        label.Parent = frame

        -- Reproduzir
        local play = Instance.new("TextButton")
        play.Size = UDim2.new(0.45,0,0.25,0)
        play.Position = UDim2.new(0.05,0,0.45,0)
        play.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        play.Text = "▶ Reproduzir"
        play.TextColor3 = Color3.new(1,1,1)
        play.Parent = frame
        play.MouseButton1Click:Connect(function()
            local data = readfile(filePath)
            local moves = HttpService:JSONDecode(data)
            PlayRecording(moves, filename)
        end)

        -- Renomear
        local rename = Instance.new("TextButton")
        rename.Size = UDim2.new(0.45,0,0.25,0)
        rename.Position = UDim2.new(0.5,0,0.45,0)
        rename.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
        rename.Text = "✏ Renomear"
        rename.TextColor3 = Color3.new(1,1,1)
        rename.Parent = frame
        rename.MouseButton1Click:Connect(function()
            local newName = "parkour_" .. os.date("%Y%m%d_%H%M%S")
            -- Simples rename
            pcall(function()
                writefile(SaveFolder .. "/" .. newName .. ".json", readfile(filePath))
                delfile(filePath)
            end)
            RefreshRecordingsList(page)
        end)

        -- Apagar
        local del = Instance.new("TextButton")
        del.Size = UDim2.new(0.45,0,0.25,0)
        del.Position = UDim2.new(0.05,0,0.75,0)
        del.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        del.Text = "🗑 Apagar"
        del.TextColor3 = Color3.new(1,1,1)
        del.Parent = frame
        del.MouseButton1Click:Connect(function()
            pcall(function() delfile(filePath) end)
            RefreshRecordingsList(page)
        end)
    end
end

local function StartRecording()
    if Recording then return end
    Recording = true
    RecordedMoves = {}
    StarterGui:SetCore("SendNotification", {Title = "ST", Text = "Gravação INICIADA", Duration = 4})

    RecordingConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                table.insert(RecordedMoves, {
                    t = tick(),
                    c = root.CFrame,
                    v = root.Velocity,
                    j = LocalPlayer.Character.Humanoid.Jump
                })
            end
        end)
    end)
end

local function StopRecording(page)
    if not Recording then return end
    Recording = false
    if RecordingConnection then RecordingConnection:Disconnect() end

    if #RecordedMoves > 10 then
        local name = "parkour_" .. os.date("%Y%m%d_%H%M%S")
        writefile(SaveFolder .. "/" .. name .. ".json", HttpService:JSONEncode(RecordedMoves))
        StarterGui:SetCore("SendNotification", {Title = "ST", Text = "Gravação salva: " .. name, Duration = 6})
    else
        StarterGui:SetCore("SendNotification", {Title = "ST", Text = "Gravação muito curta!", Duration = 4})
    end
    RefreshRecordingsList(page)
end

local function PlayRecording(moves, name)
    StarterGui:SetCore("SendNotification", {Title = "ST", Text = "Reproduzindo: " .. name, Duration = 4})
    local startTime = tick()
    local index = 1

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if index > #moves then conn:Disconnect() return end
        local move = moves[index]
        if tick() - startTime >= (move.t - moves[1].t) then
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = move.c
                    LocalPlayer.Character.HumanoidRootPart.Velocity = move.v or Vector3.new()
                    if move.j then LocalPlayer.Character.Humanoid.Jump = true end
                end
            end)
            index += 1
        end
    end)
end

