-- TEXTURA MINECRAFT (Performance)
-- =============================================
local MinecraftMode = false

local function ApplyMinecraftTextures()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Texture") then
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                obj.Material = Enum.Material.Grass -- ou Fabric, etc.
                obj.Color = Color3.fromRGB(100, 200, 50) -- Verde pixelado
            end
            if obj:IsA("Texture") then
                obj.Texture = "rbxassetid://0" -- Remove texturas pesadas
            end
        end
    end
    settings().Rendering.QualityLevel = 1 -- Baixa qualidade
    print("Modo Textura Minecraft ativado (jogo mais leve)")
end

local function RestoreNormal()
    -- Reset básico (não restaura tudo perfeitamente)
    settings().Rendering.QualityLevel = 10
    print("Modo normal restaurado")
end

CreateButton(MainFrame, "Textura Minecraft", 180, function()
    MinecraftMode = not MinecraftMode
    if MinecraftMode then
        ApplyMinecraftTextures()
    else
        RestoreNormal()
    end
end)

-- =============================================
-- SISTEMA DE GRAVAÇÃO DE PARKOUR
-- =============================================
local Recording = false
local RecordedMoves = {}
local RecordingConnection
local CurrentRecordingName = ""

local function StartRecording()
    if Recording then return end
    Recording = true
    RecordedMoves = {}
    print("Gravação INICIADA - Faça seu parkour!")
    
    RecordingConnection = RunService.Heartbeat:Connect(function(dt)
        if Character and Character:FindFirstChild("HumanoidRootPart") then
            table.insert(RecordedMoves, {
                Time = tick(),
                CFrame = Character.HumanoidRootPart.CFrame,
                Velocity = Character.HumanoidRootPart.Velocity,
                Jump = Humanoid.Jump
            })
        end
    end)
end

local function StopRecording()
    if not Recording then return end
    Recording = false
    if RecordingConnection then RecordingConnection:Disconnect() end
    
    -- Pedir nome
    local name = "recording_" .. os.date("%Y%m%d_%H%M%S")
    name = syn.request or HttpService:GenerateGUID(false) -- fallback
    
    -- Salvar
    local success, err = pcall(function()
        writefile(SaveFolder .. "/" .. name .. ".json", HttpService:JSONEncode(RecordedMoves))
    end)
    
    if success then
        print("Gravação salva como: " .. name)
        StarterGui:SetCore("SendNotification", {Title = "ST", Text = "Gravação salva: " .. name, Duration = 4})
    else
        print("Erro ao salvar: " .. tostring(err))
    end
end

local function PlayRecording(filename)
    local data = readfile(SaveFolder .. "/" .. filename)
    local moves = HttpService:JSONDecode(data)
    
    print("Reproduzindo: " .. filename)
    
    local startTime = tick()
    local index = 1
    
    local playConn
    playConn = RunService.Heartbeat:Connect(function()
        if index > #moves then
            playConn:Disconnect()
            return
        end
        
        local move = moves[index]
        local currentTime = tick() - startTime
        
        if currentTime >= (move.Time - moves[1].Time) then
            if Character and Character:FindFirstChild("HumanoidRootPart") then
                Character.HumanoidRootPart.CFrame = move.CFrame
                Character.HumanoidRootPart.Velocity = move.Velocity or Vector3.new()
                if move.Jump then
                    Humanoid.Jump = true
                end
            end
            index = index + 1
        end
    end)
end

-- Botões de Gravação
CreateButton(MainFrame, "Iniciar Gravação", 240, StartRecording)
CreateButton(MainFrame, "Parar Gravação", 300, StopRecording)

